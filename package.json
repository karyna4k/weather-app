{
  "name": "weather-widget",
  "version": "1.0.0",
  "private": true,
  "description": "A weather widget built with Vue 3 and Vite.",
  "keywords": [
    "weather",
    "widget",
    "vue",
    "vite",
    "web-component"
  ],
  "author": "karyna4k",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^2.1.7",
    "uid": "^2.0.2",
    "vue": "^3.5.43",
    "vue-draggable-next": "^2.2.1",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
